            when european_aqi <= 60 then 'Umiarkowana'
            when european_aqi <= 80 then 'Zla'
            else 'Bardzo zla'
        end as air_quality_status,
        source_file,
        current_timestamp() as dbt_updated_at
    from source
)

select * from transformed
order by measurement_timestamp desc
    );
  
